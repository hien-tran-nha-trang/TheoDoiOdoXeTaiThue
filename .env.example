# ===== BẮT BUỘC KHI CHẠY TRÊN VERCEL =====
# Chuỗi bí mật ký cookie đăng nhập (chuỗi ngẫu nhiên dài >= 32 ký tự)
AUTH_SECRET=

# Postgres (Neon / Vercel Postgres / Supabase...). Bỏ trống khi chạy local => dùng PGlite lưu trong .data/
DATABASE_URL=

# Vercel Blob (lưu ảnh ODO). Bỏ trống khi chạy local => ảnh lưu trong .data/uploads
BLOB_READ_WRITE_TOKEN=

# ===== OCR ĐỌC SỐ KM TỪ ẢNH =====
# Có key => đọc ODO bằng Claude (rất chính xác, kể cả đồng hồ điện tử LCD).
# Không có key => tự động dùng Tesseract chạy ngay trên điện thoại (kém chính xác hơn).
ANTHROPIC_API_KEY=
# Model dùng để đọc ODO (mặc định claude-opus-5-5)
OCR_MODEL=

# ===== TÀI KHOẢN QUẢN TRỊ BAN ĐẦU =====
# Chỉ dùng lần đầu khi chưa có tài khoản nào. Mặc định: admin / admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
